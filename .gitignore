# Environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Source data: 555 MB, redistributed by its publisher, not by this repo.
# Download it from Kaggle (see README) and place it in the project root.
all_variants.csv

# Derived matrices. Every one of these is regenerated by prepare_variants.py
# in a few minutes; keeping them out keeps the clone small.
data/*/isolate_variant_matrix.csv
data/*/config.run.json
data/*/config.*.json
data/.metadata_cache/
data/phenotype_sources/.phenotype_cache/

# Third-party tables that should be fetched from their source, not vendored.
data/phenotype_sources/CRyPTIC_reuse_table_*.csv
data/phenotype_sources/ncbi_pathogen_metadata.tsv
data/phenotype_sources/bvbrc_phenotypes.csv
data/phenotype_sources/bvbrc_phenotypes.report.json

# Training runs are reproducible; only the four released models are tracked.
models/*
!models/rif_genomic_baseline/
!models/iso_genomic_baseline/
!models/eth_genomic_baseline/
!models/pyr_genomic_baseline/
models/*/split_assignments.csv

# Local scratch
local_data/
predictions*.csv
!examples/predictions.csv
*.log
