# Environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Source data: 555 MB, redistributed by its publisher, not by this repo.
# Download it from Kaggle (see README) and place it in the project root.
all_variants.csv

# Everything under data/ is a rebuildable working file, EXCEPT the few below
# that the predictor and the documentation actually need. prepare_variants.py
# recreates the rest in minutes.
data/*
!data/phenotypes.csv
!data/phenotypes.report.json
!data/sample_metadata.csv
!data/sample_metadata.report.json
!data/bootstrap_ladder.json
!data/bootstrap_all_geo.json
!data/bootstrap_str.json
!data/variant_panel/
data/variant_panel/*
!data/variant_panel/feature_dictionary.csv
!data/variant_panel/prep_report.json

# Training runs are reproducible; only the five released models are tracked.
models/*
!models/rif_genomic_baseline/
!models/iso_genomic_baseline/
!models/eth_genomic_baseline/
!models/pyr_genomic_baseline/
!models/str_genomic_baseline/
models/*/split_assignments.csv

# Local scratch
local_data/
predictions*.csv
!examples/predictions.csv
*.log
